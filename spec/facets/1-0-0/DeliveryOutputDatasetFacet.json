{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alebgl77/AnswerLineage/main/spec/facets/1-0-0/DeliveryOutputDatasetFacet.json",
  "type": "object",
  "$defs": {
    "DeliveryOutputDatasetFacet": {
      "description": "Diffusion d'une réponse d'agent. Facette de jeu de données de sortie, à placer dans outputFacets : la sortie est la réponse, décrite par son empreinte. Elle ne porte pas la réponse.",
      "allOf": [
        {
          "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/OutputDatasetFacet"
        },
        {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Empreinte de la réponse. Jamais le contenu."
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Canal par lequel la réponse a été diffusée."
            },
            "messageRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Référence du message diffusé sur le canal."
            },
            "recipients": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Pseudonyme d'un destinataire."
              },
              "description": "Destinataires pseudonymisés, sans table de correspondance."
            }
          },
          "required": [
            "fingerprint",
            "channel",
            "messageRef"
          ]
        }
      ],
      "type": "object"
    }
  },
  "properties": {
    "answerlineage_delivery": {
      "$ref": "#/$defs/DeliveryOutputDatasetFacet"
    }
  }
}
