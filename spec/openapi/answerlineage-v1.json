{
  "components": {
    "schemas": {
      "BatchResult": {
        "description": "Bilan de l'ingestion d'un lot.",
        "properties": {
          "accepted": {
            "description": "Événements valides, enregistrés ou déjà connus.",
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "description": "Événements valides déjà connus, sans effet.",
            "title": "Duplicates",
            "type": "integer"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/Rejection"
            },
            "title": "Rejected",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "duplicates",
          "rejected"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "EventRejected": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "title": "EventRejected",
        "type": "object"
      },
      "EventResult": {
        "description": "Bilan de l'ingestion d'un événement.",
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "event_id": {
            "description": "Identifiant déterministe de l'événement.",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "duplicate"
        ],
        "title": "EventResult",
        "type": "object"
      },
      "Facet": {
        "additionalProperties": true,
        "description": "Facette OpenLineage : tout champ est admis, producteur et schéma sont exigés.",
        "properties": {
          "_producer": {
            "format": "uri",
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "_schemaURL": {
            "format": "uri",
            "minLength": 1,
            "title": "Schemaurl",
            "type": "string"
          }
        },
        "required": [
          "_producer",
          "_schemaURL"
        ],
        "title": "Facet",
        "type": "object"
      },
      "FieldError": {
        "description": "Champ fautif d'un événement rejeté.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "Pointeur JSON (RFC 6901) vers le champ fautif.",
            "title": "Path",
            "type": "string"
          },
          "type": {
            "description": "Code stable du motif de rejet.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "path",
          "type",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "InputDataset": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "inputFacets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Inputfacets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "InputDataset",
        "type": "object"
      },
      "Job": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "Job",
        "type": "object"
      },
      "OutputDataset": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "outputFacets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Outputfacets",
            "type": "object"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "OutputDataset",
        "type": "object"
      },
      "Rejection": {
        "description": "Événement rejeté d'un lot.",
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "index": {
            "description": "Rang de l'événement dans le lot, à partir de zéro.",
            "title": "Index",
            "type": "integer"
          }
        },
        "required": [
          "index",
          "errors"
        ],
        "title": "Rejection",
        "type": "object"
      },
      "RequestRefused": {
        "properties": {
          "error": {
            "description": "Code stable du motif de refus.",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "RequestRefused",
        "type": "object"
      },
      "Run": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "runId": {
            "format": "uuid",
            "title": "Runid",
            "type": "string"
          }
        },
        "required": [
          "runId"
        ],
        "title": "Run",
        "type": "object"
      },
      "RunEvent": {
        "description": "Événement d'exécution OpenLineage.",
        "properties": {
          "eventTime": {
            "format": "date-time",
            "title": "Eventtime",
            "type": "string"
          },
          "eventType": {
            "default": "OTHER",
            "enum": [
              "START",
              "RUNNING",
              "COMPLETE",
              "ABORT",
              "FAIL",
              "OTHER"
            ],
            "title": "Eventtype",
            "type": "string"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/InputDataset"
            },
            "title": "Inputs",
            "type": "array"
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputDataset"
            },
            "title": "Outputs",
            "type": "array"
          },
          "producer": {
            "format": "uri",
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          },
          "schemaURL": {
            "format": "uri",
            "minLength": 1,
            "title": "Schemaurl",
            "type": "string"
          }
        },
        "required": [
          "eventTime",
          "producer",
          "schemaURL",
          "run",
          "job"
        ],
        "title": "RunEvent",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Lignage et rappel des réponses d'agents",
    "title": "AnswerLineage",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/lineage": {
      "post": {
        "description": "Point d'entrée standard d'OpenLineage : un émetteur conforme s'y branche tel quel.",
        "operationId": "ingest_event_api_v1_lineage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps n'est pas du JSON."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRejected"
                }
              }
            },
            "description": "L'événement est invalide."
          }
        },
        "summary": "Envoie un RunEvent OpenLineage",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/api/v1/lineage/batch": {
      "post": {
        "description": "Chaque événement est validé séparément : un événement invalide est rejeté\navec le chemin de ses champs fautifs, le reste du lot est accepté.",
        "operationId": "ingest_batch_api_v1_lineage_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/RunEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps n'est pas un tableau JSON."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le lot dépasse la taille maximale."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Aucun événement du lot n'est valide."
          }
        },
        "summary": "Envoie un lot de RunEvents OpenLineage",
        "tags": [
          "ingestion"
        ]
      }
    }
  }
}
