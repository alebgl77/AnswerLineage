{
  "components": {
    "schemas": {
      "AgentName": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "AgentName",
        "type": "object"
      },
      "AnswerList": {
        "properties": {
          "answers": {
            "items": {
              "$ref": "#/components/schemas/AnswerSummary"
            },
            "title": "Answers",
            "type": "array"
          }
        },
        "required": [
          "answers"
        ],
        "title": "AnswerList",
        "type": "object"
      },
      "AnswerSummary": {
        "description": "Une réponse d'agent, désignée par son empreinte.",
        "properties": {
          "agent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentName"
              },
              {
                "type": "null"
              }
            ],
            "description": "Agent du run, quand il est connu."
          },
          "fingerprint": {
            "description": "Empreinte de la réponse : son contenu n'est pas conservé.",
            "title": "Fingerprint",
            "type": "string"
          },
          "id": {
            "description": "Identifiant stable de la réponse.",
            "title": "Id",
            "type": "string"
          },
          "produced_at": {
            "format": "date-time",
            "title": "Produced At",
            "type": "string"
          },
          "run_id": {
            "description": "Run de l'agent qui a produit la réponse.",
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fingerprint",
          "produced_at",
          "run_id",
          "agent"
        ],
        "title": "AnswerSummary",
        "type": "object"
      },
      "BatchResult": {
        "description": "Bilan de l'ingestion d'un lot.",
        "properties": {
          "accepted": {
            "description": "Événements valides, enregistrés ou déjà connus.",
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "description": "Événements valides déjà connus, sans effet.",
            "title": "Duplicates",
            "type": "integer"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/Rejection"
            },
            "title": "Rejected",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "duplicates",
          "rejected"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "DatasetSource": {
        "description": "Un jeu de données lu pour produire la réponse.",
        "properties": {
          "columns": {
            "description": "Colonnes lues, quand toutes les lectures les donnent.",
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "first_read_at": {
            "format": "date-time",
            "title": "First Read At",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "last_read_at": {
            "format": "date-time",
            "title": "Last Read At",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "precision": {
            "description": "Ce que l'on sait de la lecture. « table » : le jeu entier est une source.",
            "enum": [
              "table",
              "columns",
              "subset",
              "keys"
            ],
            "title": "Precision",
            "type": "string"
          },
          "versions": {
            "description": "Versions lues, quand l'émetteur les a déclarées.",
            "items": {
              "type": "string"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
          "namespace",
          "name",
          "kind",
          "versions",
          "precision",
          "columns",
          "first_read_at",
          "last_read_at"
        ],
        "title": "DatasetSource",
        "type": "object"
      },
      "EventRejected": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "title": "EventRejected",
        "type": "object"
      },
      "EventResult": {
        "description": "Bilan de l'ingestion d'un événement.",
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "event_id": {
            "description": "Identifiant déterministe de l'événement.",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "duplicate"
        ],
        "title": "EventResult",
        "type": "object"
      },
      "Facet": {
        "additionalProperties": true,
        "description": "Facette OpenLineage : tout champ est admis, producteur et schéma sont exigés.",
        "properties": {
          "_producer": {
            "format": "uri",
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "_schemaURL": {
            "format": "uri",
            "minLength": 1,
            "title": "Schemaurl",
            "type": "string"
          }
        },
        "required": [
          "_producer",
          "_schemaURL"
        ],
        "title": "Facet",
        "type": "object"
      },
      "FieldError": {
        "description": "Champ fautif d'un événement rejeté.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "Pointeur JSON (RFC 6901) vers le champ fautif.",
            "title": "Path",
            "type": "string"
          },
          "type": {
            "description": "Code stable du motif de rejet.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "path",
          "type",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "InputDataset": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "inputFacets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Inputfacets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "InputDataset",
        "type": "object"
      },
      "Job": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "Job",
        "type": "object"
      },
      "OutputDataset": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "outputFacets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Outputfacets",
            "type": "object"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "OutputDataset",
        "type": "object"
      },
      "Rejection": {
        "description": "Événement rejeté d'un lot.",
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "index": {
            "description": "Rang de l'événement dans le lot, à partir de zéro.",
            "title": "Index",
            "type": "integer"
          }
        },
        "required": [
          "index",
          "errors"
        ],
        "title": "Rejection",
        "type": "object"
      },
      "RequestRefused": {
        "properties": {
          "error": {
            "description": "Code stable du motif de refus.",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "RequestRefused",
        "type": "object"
      },
      "RequestRejected": {
        "description": "Requête dont un paramètre est invalide.",
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "title": "RequestRejected",
        "type": "object"
      },
      "Run": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "title": "Facets",
            "type": "object"
          },
          "runId": {
            "format": "uuid",
            "title": "Runid",
            "type": "string"
          }
        },
        "required": [
          "runId"
        ],
        "title": "Run",
        "type": "object"
      },
      "RunEvent": {
        "description": "Événement d'exécution OpenLineage.",
        "properties": {
          "eventTime": {
            "format": "date-time",
            "title": "Eventtime",
            "type": "string"
          },
          "eventType": {
            "default": "OTHER",
            "enum": [
              "START",
              "RUNNING",
              "COMPLETE",
              "ABORT",
              "FAIL",
              "OTHER"
            ],
            "title": "Eventtype",
            "type": "string"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/InputDataset"
            },
            "title": "Inputs",
            "type": "array"
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputDataset"
            },
            "title": "Outputs",
            "type": "array"
          },
          "producer": {
            "format": "uri",
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          },
          "schemaURL": {
            "format": "uri",
            "minLength": 1,
            "title": "Schemaurl",
            "type": "string"
          }
        },
        "required": [
          "eventTime",
          "producer",
          "schemaURL",
          "run",
          "job"
        ],
        "title": "RunEvent",
        "type": "object"
      },
      "Sources": {
        "description": "Les sources d'une réponse : ce que son run et ses runs enfants ont lu.",
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentName"
            },
            "title": "Agents",
            "type": "array"
          },
          "answer": {
            "$ref": "#/components/schemas/AnswerSummary"
          },
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/DatasetSource"
            },
            "title": "Datasets",
            "type": "array"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolUse"
            },
            "title": "Tools",
            "type": "array"
          },
          "truncated": {
            "description": "Vrai quand l'arbre des runs dépasse la borne : les sources sont partielles.",
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "answer",
          "agents",
          "tools",
          "datasets",
          "truncated"
        ],
        "title": "Sources",
        "type": "object"
      },
      "ToolUse": {
        "properties": {
          "calls": {
            "description": "Appels de cet outil faits pour produire la réponse.",
            "title": "Calls",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server": {
            "title": "Server",
            "type": "string"
          }
        },
        "required": [
          "server",
          "name",
          "calls"
        ],
        "title": "ToolUse",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Lignage et rappel des réponses d'agents",
    "title": "AnswerLineage",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/answers": {
      "get": {
        "description": "Le destinataire d'un message retrouve la réponse d'agent qu'il porte.",
        "operationId": "find_answers_api_v1_answers_get",
        "parameters": [
          {
            "description": "Canal de diffusion du message, tel que l'émetteur le nomme.",
            "in": "query",
            "name": "channel",
            "required": true,
            "schema": {
              "description": "Canal de diffusion du message, tel que l'émetteur le nomme.",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "title": "Channel",
              "type": "string"
            }
          },
          {
            "description": "Référence du message dans ce canal.",
            "in": "query",
            "name": "message_ref",
            "required": true,
            "schema": {
              "description": "Référence du message dans ce canal.",
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "title": "Message Ref",
              "type": "string"
            }
          },
          {
            "description": "Nombre maximal de réponses renvoyées.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Nombre maximal de réponses renvoyées.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          }
        },
        "summary": "Retrouve les réponses diffusées par un message",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/answers/{answer_id}/sources": {
      "get": {
        "description": "Jeux de données et versions lus, outils appelés et agents intervenus, sans contenu.",
        "operationId": "answer_sources_api_v1_answers__answer_id__sources_get",
        "parameters": [
          {
            "description": "Identifiant de la réponse, tel que l'API le donne.",
            "in": "path",
            "name": "answer_id",
            "required": true,
            "schema": {
              "description": "Identifiant de la réponse, tel que l'API le donne.",
              "pattern": "^[0-9a-f]{48}$",
              "title": "Answer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sources"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Aucune réponse ne porte cet identifiant."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          }
        },
        "summary": "Remonte d'une réponse à ses sources",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/lineage": {
      "post": {
        "description": "Point d'entrée standard d'OpenLineage : un émetteur conforme s'y branche tel quel.",
        "operationId": "ingest_event_api_v1_lineage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps n'est pas du JSON."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRejected"
                }
              }
            },
            "description": "L'événement est invalide."
          }
        },
        "summary": "Envoie un RunEvent OpenLineage",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/api/v1/lineage/batch": {
      "post": {
        "description": "Chaque événement est validé séparément : un événement invalide est rejeté\navec le chemin de ses champs fautifs, le reste du lot est accepté.",
        "operationId": "ingest_batch_api_v1_lineage_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/RunEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps n'est pas un tableau JSON."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le lot dépasse la taille maximale."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Aucun événement du lot n'est valide."
          }
        },
        "summary": "Envoie un lot de RunEvents OpenLineage",
        "tags": [
          "ingestion"
        ]
      }
    }
  }
}
