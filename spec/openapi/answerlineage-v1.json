            "type": "integer"
          }
        },
        "required": [
          "index",
          "errors"
        ],
        "title": "Rejection",
        "type": "object"
      },
      "RequestRefused": {
        "properties": {
          "error": {
            "description": "Code stable du motif de refus.",
