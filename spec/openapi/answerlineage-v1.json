{
  "components": {
    "schemas": {
      "AgentName": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "AgentName",
        "type": "object"
      },
      "AgentNode": {
        "properties": {
          "id": {
            "description": "Identifiant du nœud, valable dans cette réponse seulement.",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "id",
          "namespace",
          "name"
        ],
        "title": "AgentNode",
        "type": "object"
      },
      "AnswerList": {
        "properties": {
          "answers": {
            "items": {
              "$ref": "#/components/schemas/AnswerSummary"
            },
            "title": "Answers",
            "type": "array"
          }
        },
        "required": [
          "answers"
        ],
        "title": "AnswerList",
        "type": "object"
      },
      "AnswerNode": {
        "description": "Une réponse et sa chaîne, d'une colonne à l'autre.",
        "properties": {
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Nœud de l'agent qui a répondu, quand il est connu.",
            "title": "Agent"
          },
          "channels": {
            "description": "Canaux par lesquels la réponse a été diffusée.",
            "items": {
              "type": "string"
            },
            "title": "Channels",
            "type": "array"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "id": {
            "description": "Identifiant stable de la réponse.",
            "title": "Id",
            "type": "string"
          },
          "produced_at": {
            "format": "date-time",
            "title": "Produced At",
            "type": "string"
          },
          "reads": {
            "items": {
              "$ref": "#/components/schemas/AnswerRead"
            },
            "title": "Reads",
            "type": "array"
          },
          "recipients": {
            "description": "Nœuds des destinataires.",
            "items": {
              "type": "string"
            },
            "title": "Recipients",
            "type": "array"
          },
          "tools": {
            "description": "Nœuds des outils appelés.",
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "id",
          "fingerprint",
          "produced_at",
          "agent",
          "channels",
          "recipients",
          "tools",
          "reads"
        ],
        "title": "AnswerNode",
        "type": "object"
      },
      "AnswerRead": {
        "description": "Une lecture faite pour produire la réponse.",
        "properties": {
          "dataset": {
            "description": "Nœud du jeu de données lu.",
            "title": "Dataset",
            "type": "string"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Nœud de l'outil qui a lu, quand un outil a lu.",
            "title": "Tool"
          }
        },
        "required": [
          "dataset",
          "tool"
        ],
        "title": "AnswerRead",
        "type": "object"
      },
      "AnswerSummary": {
        "description": "Une réponse d'agent, désignée par son empreinte.",
        "properties": {
          "agent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentName"
              },
              {
                "type": "null"
              }
            ],
            "description": "Agent du run, quand il est connu."
          },
          "fingerprint": {
            "description": "Empreinte de la réponse : son contenu n'est pas conservé.",
            "title": "Fingerprint",
            "type": "string"
          },
          "id": {
            "description": "Identifiant stable de la réponse.",
            "title": "Id",
            "type": "string"
          },
          "produced_at": {
            "format": "date-time",
            "title": "Produced At",
            "type": "string"
          },
          "run_id": {
            "description": "Run de l'agent qui a produit la réponse.",
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fingerprint",
          "produced_at",
          "run_id",
          "agent"
        ],
        "title": "AnswerSummary",
        "type": "object"
      },
      "BatchResult": {
        "description": "Bilan de l'ingestion d'un lot.",
        "properties": {
          "accepted": {
            "description": "Événements valides, enregistrés ou déjà connus.",
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "description": "Événements valides déjà connus, sans effet.",
            "title": "Duplicates",
            "type": "integer"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/Rejection"
            },
            "title": "Rejected",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "duplicates",
          "rejected"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "Coverage": {
        "description": "Ce que l'on sait de la part des appels captés pendant la fenêtre.",
        "properties": {
          "status": {
            "const": "unknown",
            "description": "« unknown » : la couverture du lignage n'est pas encore mesurée.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "DatasetList": {
        "description": "Les jeux de données connus du graphe, par espace de noms puis par nom.",
        "properties": {
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/DatasetName"
            },
            "title": "Datasets",
            "type": "array"
          },
          "more": {
            "description": "Vrai quand la liste dépasse la borne demandée.",
            "title": "More",
            "type": "boolean"
          }
        },
        "required": [
          "datasets",
          "more"
        ],
        "title": "DatasetList",
        "type": "object"
      },
      "DatasetName": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name",
          "kind"
        ],
        "title": "DatasetName",
        "type": "object"
      },
      "DatasetNode": {
        "properties": {
          "id": {
            "description": "Identifiant du nœud, valable dans cette réponse seulement.",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "id",
          "namespace",
          "name",
          "kind"
        ],
        "title": "DatasetNode",
        "type": "object"
      },
      "DatasetSource": {
        "description": "Un jeu de données lu pour produire la réponse.",
        "properties": {
          "columns": {
            "description": "Colonnes lues, quand toutes les lectures les donnent.",
            "items": {
              "type": "string"
            },
            "title": "Columns",
            "type": "array"
          },
          "first_read_at": {
            "format": "date-time",
            "title": "First Read At",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "last_read_at": {
            "format": "date-time",
            "title": "Last Read At",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "precision": {
            "description": "Ce que l'on sait de la lecture. « table » : le jeu entier est une source.",
            "enum": [
              "table",
              "columns",
              "subset",
              "keys"
            ],
            "title": "Precision",
            "type": "string"
          },
          "versions": {
            "description": "Versions lues, quand l'émetteur les a déclarées.",
            "items": {
              "type": "string"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
          "namespace",
          "name",
          "kind",
          "versions",
          "precision",
          "columns",
          "first_read_at",
          "last_read_at"
        ],
        "title": "DatasetSource",
        "type": "object"
      },
      "DuplicateCount": {
        "description": "Doublons reçus d'un émetteur, un jour.",
        "properties": {
          "count": {
            "description": "Événements reçus alors qu'ils étaient déjà connus.",
            "title": "Count",
            "type": "integer"
          },
          "day": {
            "description": "Jour UTC de réception.",
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "emitter": {
            "description": "Espace de noms du job des événements.",
            "title": "Emitter",
            "type": "string"
          }
        },
        "required": [
          "emitter",
          "day",
          "count"
        ],
        "title": "DuplicateCount",
        "type": "object"
      },
      "DuplicateList": {
        "properties": {
          "duplicates": {
            "items": {
              "$ref": "#/components/schemas/DuplicateCount"
            },
            "title": "Duplicates",
            "type": "array"
          }
        },
        "required": [
          "duplicates"
        ],
        "title": "DuplicateList",
        "type": "object"
      },
      "EventRejected": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "title": "EventRejected",
        "type": "object"
      },
      "EventResult": {
        "description": "Bilan de l'ingestion d'un événement.",
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "event_id": {
            "description": "Identifiant déterministe de l'événement.",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "duplicate"
        ],
        "title": "EventResult",
        "type": "object"
      },
      "Facet": {
        "additionalProperties": true,
        "description": "Facette OpenLineage : tout champ est admis, producteur et schéma sont exigés.",
        "properties": {
          "_producer": {
            "format": "uri",
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "_schemaURL": {
            "format": "uri",
            "minLength": 1,
            "title": "Schemaurl",
            "type": "string"
          }
        },
        "required": [
          "_producer",
          "_schemaURL"
        ],
        "title": "Facet",
        "type": "object"
      },
      "FieldError": {
        "description": "Champ fautif d'un événement rejeté.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "Pointeur JSON (RFC 6901) vers le champ fautif.",
            "title": "Path",
            "type": "string"
          },
          "type": {
            "description": "Code stable du motif de rejet.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "path",
          "type",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "GraphView": {
        "description": "Le graphe en cinq colonnes : données, outils, agents, réponses, destinataires.",
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentNode"
            },
            "title": "Agents",
            "type": "array"
          },
          "answers": {
            "description": "Les plus récentes d'abord.",
            "items": {
              "$ref": "#/components/schemas/AnswerNode"
            },
            "title": "Answers",
            "type": "array"
          },
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/DatasetNode"
            },
            "title": "Datasets",
            "type": "array"
          },
          "more": {
            "description": "Vrai quand des réponses plus anciennes existent.",
            "title": "More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Curseur de la page suivante, à rendre tel quel dans le paramètre « cursor ». Nul quand il n'y a plus de réponse.",
            "title": "Next Cursor"
          },
          "recipients": {
            "items": {
              "$ref": "#/components/schemas/RecipientNode"
            },
            "title": "Recipients",
            "type": "array"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolNode"
            },
            "title": "Tools",
            "type": "array"
          },
          "truncated": {
            "description": "Vrai quand les chaînes des réponses dépassent une borne (runs, lectures, destinataires) : la vue est partielle.",
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "datasets",
          "tools",
          "agents",
          "answers",
          "recipients",
          "more",
          "next_cursor",
          "truncated"
        ],
        "title": "GraphView",
        "type": "object"
      },
      "ImpactCounts": {
        "description": "Décomptes sur tout l'incident, quelle que soit la page demandée.",
        "properties": {
          "answers": {
            "description": "Réponses touchées.",
            "title": "Answers",
            "type": "integer"
          },
          "lower_bound": {
            "description": "Vrai quand le résultat est tronqué : les décomptes sont des minimums, et zéro ne veut pas dire que rien n'est touché.",
            "title": "Lower Bound",
            "type": "boolean"
          },
          "recipients": {
            "description": "Destinataires distincts de ces réponses.",
            "title": "Recipients",
            "type": "integer"
          }
        },
        "required": [
          "answers",
          "recipients",
          "lower_bound"
        ],
        "title": "ImpactCounts",
        "type": "object"
      },
      "ImpactResult": {
        "description": "Les réponses et les destinataires touchés par un jeu de données faux pendant une fenêtre.",
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/ImpactCounts"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "dataset": {
            "$ref": "#/components/schemas/DatasetName"
          },
          "graph": {
            "$ref": "#/components/schemas/GraphView",
            "description": "Les réponses touchées, les plus récentes d'abord, avec leur chaîne."
          },
          "truncated": {
            "description": "Vrai quand la propagation dépasse une borne : le résultat est partiel, d'autres réponses peuvent être touchées, et les décomptes sont des minimums.",
            "title": "Truncated",
            "type": "boolean"
          },
          "window": {
            "$ref": "#/components/schemas/Window"
          }
        },
        "required": [
          "dataset",
          "window",
          "counts",
          "coverage",
          "graph",
          "truncated"
        ],
        "title": "ImpactResult",
        "type": "object"
      },
      "InputDataset": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "maxProperties": 100,
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "title": "Facets",
            "type": "object"
          },
          "inputFacets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "maxProperties": 100,
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "title": "Inputfacets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "InputDataset",
        "type": "object"
      },
      "Job": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "maxProperties": 100,
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "title": "Facets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "Job",
        "type": "object"
      },
      "OutputDataset": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "maxProperties": 100,
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "title": "Facets",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "outputFacets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "maxProperties": 100,
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "title": "Outputfacets",
            "type": "object"
          }
        },
        "required": [
          "namespace",
          "name"
        ],
        "title": "OutputDataset",
        "type": "object"
      },
      "RecipientNode": {
        "properties": {
          "id": {
            "description": "Identifiant du nœud, valable dans cette réponse seulement.",
