            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "RequestRefused",
        "type": "object"
      },
      "RequestRejected": {
        "description": "Requête dont un paramètre est invalide.",
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "title": "RequestRejected",
        "type": "object"
      },
      "Run": {
        "properties": {
          "facets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Facet"
            },
            "maxProperties": 100,
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "title": "Facets",
            "type": "object"
          },
          "runId": {
            "format": "uuid",
            "title": "Runid",
            "type": "string"
          }
        },
        "required": [
          "runId"
        ],
        "title": "Run",
        "type": "object"
      },
      "RunEvent": {
        "description": "Événement d'exécution OpenLineage.",
        "properties": {
          "eventTime": {
            "format": "date-time",
            "title": "Eventtime",
            "type": "string"
          },
          "eventType": {
            "default": "OTHER",
            "enum": [
              "START",
              "RUNNING",
              "COMPLETE",
              "ABORT",
              "FAIL",
              "OTHER"
            ],
            "title": "Eventtype",
            "type": "string"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/InputDataset"
            },
            "maxItems": 1000,
            "title": "Inputs",
            "type": "array"
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputDataset"
            },
            "maxItems": 1000,
            "title": "Outputs",
            "type": "array"
          },
          "producer": {
            "format": "uri",
            "minLength": 1,
            "title": "Producer",
            "type": "string"
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          },
          "schemaURL": {
            "format": "uri",
            "minLength": 1,
            "title": "Schemaurl",
            "type": "string"
          }
        },
        "required": [
          "eventTime",
          "producer",
          "schemaURL",
          "run",
          "job"
        ],
        "title": "RunEvent",
        "type": "object"
      },
      "Sources": {
        "description": "Les sources d'une réponse : ce que son run et ses runs enfants ont lu.",
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentName"
            },
            "title": "Agents",
            "type": "array"
          },
          "answer": {
            "$ref": "#/components/schemas/AnswerSummary"
          },
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/DatasetSource"
            },
            "title": "Datasets",
            "type": "array"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolUse"
            },
            "title": "Tools",
            "type": "array"
          },
          "truncated": {
            "description": "Vrai quand l'arbre des runs ou ses lectures dépassent leur borne : les sources sont partielles.",
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "answer",
          "agents",
          "tools",
          "datasets",
          "truncated"
        ],
        "title": "Sources",
        "type": "object"
      },
      "ToolNode": {
        "properties": {
          "id": {
            "description": "Identifiant du nœud, valable dans cette réponse seulement.",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server": {
            "title": "Server",
            "type": "string"
          }
        },
        "required": [
          "id",
          "server",
          "name"
        ],
        "title": "ToolNode",
        "type": "object"
      },
      "ToolUse": {
        "properties": {
          "calls": {
            "description": "Appels de cet outil faits pour produire la réponse.",
            "title": "Calls",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server": {
            "title": "Server",
            "type": "string"
          }
        },
        "required": [
          "server",
          "name",
          "calls"
        ],
        "title": "ToolUse",
        "type": "object"
      },
      "Window": {
        "description": "Fenêtre de l'incident : début inclus, fin exclue.",
        "properties": {
          "from": {
            "format": "date-time",
            "title": "From",
            "type": "string"
          },
          "to": {
            "format": "date-time",
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "title": "Window",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Lignage et rappel des réponses d'agents",
    "title": "AnswerLineage",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/answers": {
      "get": {
        "description": "Le destinataire d'un message retrouve la réponse d'agent qu'il porte.",
        "operationId": "find_answers_api_v1_answers_get",
        "parameters": [
          {
            "description": "Canal de diffusion du message, tel que l'émetteur le nomme.",
            "in": "query",
            "name": "channel",
            "required": true,
            "schema": {
              "description": "Canal de diffusion du message, tel que l'émetteur le nomme.",
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "title": "Channel",
              "type": "string"
            }
          },
          {
            "description": "Référence du message dans ce canal.",
            "in": "query",
            "name": "message_ref",
            "required": true,
            "schema": {
              "description": "Référence du message dans ce canal.",
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "title": "Message Ref",
              "type": "string"
            }
          },
          {
            "description": "Nombre maximal de réponses renvoyées.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Nombre maximal de réponses renvoyées.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "La lecture a dépassé son délai maximal : PostgreSQL l'a interrompue (« query_timeout »)."
          }
        },
        "summary": "Retrouve les réponses diffusées par un message",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/answers/{answer_id}/sources": {
      "get": {
        "description": "Jeux de données et versions lus, outils appelés et agents intervenus, sans contenu.",
        "operationId": "answer_sources_api_v1_answers__answer_id__sources_get",
        "parameters": [
          {
            "description": "Identifiant de la réponse, tel que l'API le donne.",
            "in": "path",
            "name": "answer_id",
            "required": true,
            "schema": {
              "description": "Identifiant de la réponse, tel que l'API le donne.",
              "pattern": "^[0-9a-f]{48}$",
              "title": "Answer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sources"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Aucune réponse ne porte cet identifiant."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "La lecture a dépassé son délai maximal : PostgreSQL l'a interrompue (« query_timeout »)."
          }
        },
        "summary": "Remonte d'une réponse à ses sources",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/datasets": {
      "get": {
        "description": "Les jeux de données lus ou écrits par un run, par espace de noms puis par nom.",
        "operationId": "datasets_api_v1_datasets_get",
        "parameters": [
          {
            "description": "Nombre maximal de jeux de données renvoyés.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "description": "Nombre maximal de jeux de données renvoyés.",
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "La lecture a dépassé son délai maximal : PostgreSQL l'a interrompue (« query_timeout »)."
          }
        },
        "summary": "Liste les jeux de données connus du graphe",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/graph": {
      "get": {
        "description": "Données, outils, agents, réponses et destinataires, avec la chaîne de chaque réponse.",
        "operationId": "graph_api_v1_graph_get",
        "parameters": [
          {
            "description": "Nombre maximal de réponses dans la vue.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 60,
              "description": "Nombre maximal de réponses dans la vue.",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Curseur opaque de la page suivante, tel que l'API le donne dans « next_cursor ».",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[0-9]{1,18}\\.[0-9a-f]{48}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Curseur opaque de la page suivante, tel que l'API le donne dans « next_cursor ».",
              "title": "Cursor"
            }
          },
          {
            "description": "Identifiant d'une réponse : la vue se réduit alors à sa chaîne.",
            "in": "query",
            "name": "answer",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{48}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Identifiant d'une réponse : la vue se réduit alors à sa chaîne.",
              "title": "Answer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Aucune réponse ne porte cet identifiant."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "La lecture a dépassé son délai maximal : PostgreSQL l'a interrompue (« query_timeout »)."
          }
        },
        "summary": "Donne le graphe en cinq colonnes des réponses les plus récentes, ou d'une réponse",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/impact": {
      "get": {
        "description": "Réponses dont un run a lu le jeu de données pendant la fenêtre, et leurs destinataires.",
        "operationId": "propagate_api_v1_impact_get",
        "parameters": [
          {
            "description": "Espace de noms du jeu de données, par exemple « bigquery ».",
            "in": "query",
            "name": "namespace",
            "required": true,
            "schema": {
              "description": "Espace de noms du jeu de données, par exemple « bigquery ».",
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "description": "Nom du jeu de données.",
            "in": "query",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Nom du jeu de données.",
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Début de la fenêtre, inclus (RFC 3339, avec fuseau).",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "Début de la fenêtre, inclus (RFC 3339, avec fuseau).",
              "format": "date-time",
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "Fin de la fenêtre, exclue (RFC 3339, avec fuseau).",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "Fin de la fenêtre, exclue (RFC 3339, avec fuseau).",
              "format": "date-time",
              "title": "To",
              "type": "string"
            }
          },
          {
            "description": "Nombre maximal de réponses dans la vue.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "description": "Nombre maximal de réponses dans la vue.",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Curseur opaque de la page suivante, tel que l'API le donne dans « next_cursor ».",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[0-9]{1,18}\\.[0-9a-f]{48}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Curseur opaque de la page suivante, tel que l'API le donne dans « next_cursor ».",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpactResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Ce jeu de données n'est pas connu."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "La lecture a dépassé son délai maximal : PostgreSQL l'a interrompue (« query_timeout »)."
          }
        },
        "summary": "Propage un incident de données jusqu'aux réponses et aux destinataires",
        "tags": [
          "lignage"
        ]
      }
    },
    "/api/v1/ingestion/duplicates": {
      "get": {
        "description": "Du jour le plus récent au plus ancien. Sans doublon, un émetteur n'a pas de ligne.\n\nComme toute lecture, elle s'exécute sous le délai maximal des lectures.",
        "operationId": "duplicates_api_v1_ingestion_duplicates_get",
        "parameters": [
          {
            "description": "Nombre maximal de lignes (émetteur et jour) renvoyées.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Nombre maximal de lignes (émetteur et jour) renvoyées.",
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRejected"
                }
              }
            },
            "description": "Un paramètre est invalide."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "La lecture a dépassé son délai maximal : PostgreSQL l'a interrompue (« query_timeout »)."
          }
        },
        "summary": "Compte les événements reçus en double, par émetteur et par jour",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/api/v1/lineage": {
      "post": {
        "description": "Point d'entrée standard d'OpenLineage : un émetteur conforme s'y branche tel quel.\n\nLe corps peut être compressé (``Content-Encoding: gzip``).",
        "operationId": "ingest_event_api_v1_lineage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps n'est pas du JSON en UTF-8 (`invalid_json`), dépasse la profondeur maximale (`json_too_deep`) ou n'est pas un flux gzip complet (`invalid_gzip`)."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps dépasse la taille maximale, en octets reçus ou déployés (`body_too_large`)."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps porte un autre encodage que gzip, ou plusieurs (`unsupported_content_encoding`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRejected"
                }
              }
            },
            "description": "L'événement est invalide."
          }
        },
        "summary": "Envoie un RunEvent OpenLineage",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/api/v1/lineage/batch": {
      "post": {
        "description": "Chaque événement est validé séparément : un événement invalide est rejeté\navec le chemin de ses champs fautifs, le reste du lot est accepté.\n\nLe corps peut être compressé (``Content-Encoding: gzip``).",
        "operationId": "ingest_batch_api_v1_lineage_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/RunEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps n'est pas du JSON en UTF-8 (`invalid_json`), dépasse la profondeur maximale (`json_too_deep`) ou n'est pas un flux gzip complet (`invalid_gzip`). Ou bien ce n'est pas un tableau (`batch_must_be_an_array`)."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps dépasse la taille maximale, en octets reçus ou déployés (`body_too_large`). Ou bien le lot compte plus d'événements que le maximum (`batch_too_large`)."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRefused"
                }
              }
            },
            "description": "Le corps porte un autre encodage que gzip, ou plusieurs (`unsupported_content_encoding`)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            },
            "description": "Aucun événement du lot n'est valide."
          }
        },
        "summary": "Envoie un lot de RunEvents OpenLineage",
        "tags": [
          "ingestion"
        ]
      }
    }
  }
}
