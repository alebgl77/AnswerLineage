      "title": "Une balise en guise de nom de facette : le chemin du rejet ne la cite pas",
      "surface": "ingestion",
      "base": "ingestion/appel-outil",
      "alter": {
        "field": "/body/0/run/facets/<svg onload=canari7c1d>",
        "value": {"_producer": "https://exemple.fr/emetteur", "_schemaURL": "https://exemple.fr/facette.json"}
      },
      "expect": {"verdict": "rejete", "index": 0, "path": "/run/facets", "code": "identifier_markup"}
    },
    {
      "name": "facette-nom-instruction",
