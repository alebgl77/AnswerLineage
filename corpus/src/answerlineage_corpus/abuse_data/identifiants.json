      "alter": {"field": "/body/0/run/facets/<svg onload=canari7c1d>", "value": {"_producer": "pas une adresse"}},
      "expect": {"verdict": "rejete", "index": 0, "path": "/run/facets", "code": "identifier_markup"}
    },
    {
      "name": "adresse-mot-de-passe",
