      "base": "ingestion/appel-outil",
      "alter": {"field": "/body/0/run/facets/parent/job/namespace", "value": "<script>canari7c1d</script>"},
      "expect": {"verdict": "rejete", "index": 0, "path": "/run/facets/parent/job/namespace", "code": "identifier_markup"}
